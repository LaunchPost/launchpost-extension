{
  "manifest_version": 3,
  "name": "launchpost",
  "version": "0.1.0",
  "description": "Launch a coin from any post on X. We never post for you.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "launchpost", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://launchpost.fun/*", "https://www.launchpost.fun/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://launchpost.fun/*", "https://www.launchpost.fun/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
